PORT=3000
# Em produção (hospedagem com proxy via socket unix), defina SOCKET_PATH
# em vez de depender de PORT. Quando SOCKET_PATH está setado, o server
# escuta nesse arquivo de socket em vez de uma porta TCP.
# SOCKET_PATH=/caminho/para/etc/nodejs/nodejs.sock

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=checklist

JWT_SECRET=troque-por-uma-chave-secreta-forte
